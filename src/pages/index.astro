---
import '@fontsource/archivo-black';
import '@fontsource/archivo/400.css';
import '@fontsource/archivo/600.css';
import '@fontsource/ibm-plex-mono/400.css';

const icons: Record<string, string> = {
	github: `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.49 0-.24-.01-.88-.01-1.73-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.5-1.11-1.5-.91-.63.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.9 1.57 2.36 1.12 2.94.85.09-.66.35-1.12.63-1.38-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.7 0 0 .84-.28 2.75 1.05a9.36 9.36 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.4.2 2.44.1 2.7.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.8-4.57 5.06.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .27.18.6.69.49A10.02 10.02 0 0 0 22 12.25C22 6.58 17.52 2 12 2Z"/></svg>`,
	keybase: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 4.5 6v5c0 4.6 3.2 8.4 7.5 10 4.3-1.6 7.5-5.4 7.5-10V6L12 3Z"/><path d="m9 11.5 2.2 2.2L15.5 9.5"/></svg>`,
	x: `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.8 3h3l-6.7 7.7L22 21h-6.2l-4.8-6.3L5.4 21h-3l7.2-8.2L2 3h6.3l4.4 5.8L17.8 3Zm-1.1 16.2h1.7L7.4 4.7H5.6l11.1 14.5Z"/></svg>`,
	medium: `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 12a6.2 6.2 0 1 1-12.5 0 6.2 6.2 0 0 1 12.5 0Zm6.9 0c0 3.2-1.4 5.8-3.1 5.8S14.2 15.2 14.2 12s1.4-5.8 3.1-5.8 3.1 2.6 3.1 5.8Zm2.7 0c0 2.9-.5 5.2-1.1 5.2S20.9 14.9 20.9 12s.5-5.2 1.1-5.2S23.1 9.1 23.1 12Z"/></svg>`,
	soundcloud: `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M1.2 13.4l.3 2.6-.3 2.6c0 .2-.2.2-.3.2s-.2 0-.3-.2l-.3-2.6.3-2.6c0-.1.1-.2.3-.2s.2.1.3.2Zm2-1.5c-.2 0-.3.1-.3.3l-.3 3.8.3 3.7c0 .2.1.3.3.3.1 0 .3-.1.3-.3l.3-3.7-.3-3.8c0-.2-.2-.3-.3-.3Zm2.2-.5c-.2 0-.3.1-.3.3l-.3 4.3.3 4.2c0 .2.1.3.3.3.2 0 .3-.1.3-.3l.4-4.2-.4-4.3c0-.2-.1-.3-.3-.3Zm2.3-.4c-.2 0-.4.2-.4.4l-.3 4.6.3 4.5c0 .2.2.4.4.4s.4-.2.4-.4l.4-4.5-.4-4.6c0-.2-.2-.4-.4-.4Zm2.5-1.6c-.3 0-.5.2-.5.5l-.3 6.1.3 4.4c0 .3.2.5.5.5s.4-.2.4-.5l.4-4.4-.4-6.1c0-.3-.2-.5-.4-.5Zm2.7-1.9c-.3 0-.5.2-.5.5v8.1l.3 4.3c0 .3.2.5.5.5s.5-.2.5-.5l.3-4.3-.3-8.1c0-.3-.2-.5-.5-.5Zm4.7.7c-.5 0-1 .1-1.4.3-.3-3.3-3-5.9-6.4-5.9-.8 0-1.6.2-2.3.4-.3.1-.3.2-.3.5v14.9c0 .3.2.5.5.5h9.9c2 0 3.7-1.7 3.7-3.8.1-2-1.6-3.7-3.7-3.7Z"/></svg>`,
	pen: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5Z"/></svg>`,
	archive: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="5" rx="1"/><path d="M5 9v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V9"/><path d="M10 13h4"/></svg>`,
	mic: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="2" width="6" height="12" rx="3"/><path d="M5 10v1a7 7 0 0 0 14 0v-1"/><path d="M12 18v4"/></svg>`,
	calendar: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 11h18"/></svg>`,
};

const links = [
	{
		label: 'GitHub',
		note: 'コード・プロジェクト',
		url: 'https://github.com/tetuo41',
		icon: 'github',
	},
	{
		label: 'Keybase',
		note: 'このドメインの署名検証',
		url: 'https://keybase.io/tetuo41',
		icon: 'keybase',
	},
	{
		label: 'Twitter(X)',
		note: '@tetuo41',
		url: 'https://twitter.com/tetuo41',
		icon: 'x',
	},
	{
		label: 'Blog「Stay Rad」',
		note: 'blog.tetuo41.com · 執筆先',
		url: 'https://blog.tetuo41.com/',
		icon: 'pen',
	},
	{
		label: 'はてなブログ',
		note: '旧ブログ(更新停止)',
		url: 'http://tetuo41.hatenablog.com/',
		icon: 'archive',
	},
	{
		label: 'SoundCloud',
		note: '音声・ラジオ',
		url: 'https://soundcloud.com/hirokihatsushika',
		icon: 'soundcloud',
	},
	{
		label: 'Medium',
		note: '@tetuo41',
		url: 'https://medium.com/@tetuo41',
		icon: 'medium',
	},
	{
		label: 'Podcast',
		note: 'Yarukinai.fm',
		url: 'https://yarukinai.fm/',
		icon: 'mic',
	},
	{
		label: 'Study Today',
		note: '勉強会イベントサイト(過去の運営)',
		url: 'http://study.tetuo41.com/',
		icon: 'calendar',
	},
];

const tickerText = 'SIGNATURE VERIFIED · KEYBASE ED25519 · TETUO41.COM · TOKYO · HIROKI HATSUSHIKA · ';
---

<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="tetuo41 (Hiroki Hatsushika) — Keybase の署名で検証された個人サイト。GitHub・ブログ・Podcast への一次リンク。" />
		<meta name="theme-color" content="#050505" />
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://tetuo41.com/" />
		<meta property="og:title" content="tetuo41 — Hiroki Hatsushika" />
		<meta property="og:description" content="Keybase の署名で検証された個人サイト。Signature-verified personal index." />
		<meta property="og:image" content="https://tetuo41.com/og.png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<title>tetuo41 — Hiroki Hatsushika</title>
	</head>
	<body>
		<div class="grain" aria-hidden="true"></div>

		<header class="nav">
			<a class="wordmark" href="/">tetuo41</a>
			<a class="chip" href="https://keybase.io/tetuo41">
				<span class="pulse" aria-hidden="true"></span>
				Keybase で検証済み<span class="chip-gloss">· Signature-verified</span>
			</a>
		</header>

		<main>
			<section class="hero">
				<h1>tetuo41</h1>
				<div class="billing">
					<p>Hiroki Hatsushika</p>
					<p>Tokyo, Japan</p>
					<p><a href="https://keybase.io/tetuo41">Signature verified — Keybase</a></p>
				</div>
				<p class="lead">
					このドメインは Keybase の署名で検証された、一次リンクの置き場所です。
					<!-- TODO: 自己紹介文をここに追記 -->
				</p>
				<div class="cta">
					<a class="btn primary" href="https://github.com/tetuo41">
						<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.49 0-.24-.01-.88-.01-1.73-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.5-1.11-1.5-.91-.63.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.9 1.57 2.36 1.12 2.94.85.09-.66.35-1.12.63-1.38-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.7 0 0 .84-.28 2.75 1.05a9.36 9.36 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.4.2 2.44.1 2.7.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.8-4.57 5.06.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .27.18.6.69.49A10.02 10.02 0 0 0 22 12.25C22 6.58 17.52 2 12 2Z"/></svg>
						GitHub
					</a>
					<a class="btn" href="https://keybase.io/tetuo41">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 4.5 6v5c0 4.6 3.2 8.4 7.5 10 4.3-1.6 7.5-5.4 7.5-10V6L12 3Z"/><path d="m9 11.5 2.2 2.2L15.5 9.5"/></svg>
						Keybase 証明を見る
					</a>
				</div>
			</section>

			<section class="links" aria-labelledby="links-h">
				<h2 id="links-h">Links</h2>
				<ul>
					{links.map((l) => (
						<li>
							<a href={l.url}>
								<span class="icon" set:html={icons[l.icon]} />
								<span class="label">{l.label}</span>
								<span class="note">{l.note}</span>
								<span class="arrow" aria-hidden="true">
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M9 7h8v8"/></svg>
								</span>
							</a>
						</li>
					))}
				</ul>
			</section>
		</main>

		<div class="ticker" aria-hidden="true">
			<div class="ticker-track">
				<span>{tickerText.repeat(8)}</span>
				<span>{tickerText.repeat(8)}</span>
			</div>
		</div>

		<footer>
			<p class="mono">ed25519 ASDO0lgP…XMwo · <a href="/keybase.txt">keybase.txt</a></p>
			<p>© 2026 tetuo41</p>
		</footer>
	</body>
</html>

<style>
	:root {
		--bg: #050505;
		--fg: #fafafa;
		--muted: #a6a6a6;
		--hairline: rgba(250, 250, 250, 0.16);
		--hairline-strong: rgba(250, 250, 250, 0.4);
		--invert-bg: #fafafa;
		--invert-fg: #050505;
		color-scheme: dark;
	}

	* {
		box-sizing: border-box;
	}
	html {
		scroll-behavior: smooth;
	}
	html {
		overflow-x: clip;
	}
	body {
		margin: 0;
		background: var(--bg);
		color: var(--fg);
		font-family: 'Archivo', 'Hiragino Kaku Gothic ProN', 'Noto Sans JP', system-ui, sans-serif;
		font-size: 16px;
		line-height: 1.7;
		-webkit-font-smoothing: antialiased;
	}
	::selection {
		background: var(--invert-bg);
		color: var(--invert-fg);
	}
	:focus-visible {
		outline: 2px solid var(--fg);
		outline-offset: 3px;
	}
	a {
		color: inherit;
	}
	html {
		scrollbar-color: #2a2a2a var(--bg);
	}

	/* film grain */
	.grain {
		position: fixed;
		inset: 0;
		z-index: 40;
		pointer-events: none;
		background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/><feColorMatrix type='saturate' values='0'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
		background-size: 180px 180px;
		opacity: 0.055;
		animation: grain-jitter 0.9s steps(1) infinite;
	}
	@keyframes grain-jitter {
		0% {
			transform: translate(0, 0);
		}
		12.5% {
			transform: translate(-2%, 1.5%);
		}
		25% {
			transform: translate(1.5%, -1%);
		}
		37.5% {
			transform: translate(-1%, 2%);
		}
		50% {
			transform: translate(2%, 1%);
		}
		62.5% {
			transform: translate(-1.5%, -1.5%);
		}
		75% {
			transform: translate(1%, 2%);
		}
		87.5% {
			transform: translate(2%, -1%);
		}
		100% {
			transform: translate(0, 0);
		}
	}

	/* nav */
	.nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 56rem;
		margin: 0 auto;
		padding: 1.4rem 1.5rem 0;
	}
	.wordmark {
		font-family: 'Archivo Black', 'Archivo', 'Hiragino Kaku Gothic ProN', 'Noto Sans JP', system-ui, sans-serif;
		font-weight: 400;
		font-size: 1rem;
		letter-spacing: 0.01em;
		text-transform: uppercase;
		text-decoration: none;
	}
	.chip {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--muted);
		text-decoration: none;
		border: 1px solid var(--hairline);
		padding: 0.42rem 0.8rem;
		transition: color 160ms ease, border-color 160ms ease, background 160ms ease;
	}
	.chip:hover {
		color: var(--invert-fg);
		background: var(--invert-bg);
		border-color: var(--invert-bg);
	}
	.chip:hover .pulse {
		background: var(--invert-fg);
		animation: none;
	}
	.pulse {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--fg);
		animation: pulse 2.4s ease-out infinite;
	}
	@keyframes pulse {
		0% {
			box-shadow: 0 0 0 0 rgba(250, 250, 250, 0.35);
		}
		70% {
			box-shadow: 0 0 0 7px transparent;
		}
		100% {
			box-shadow: 0 0 0 0 transparent;
		}
	}

	main {
		max-width: 56rem;
		margin: 0 auto;
		padding: 0 1.5rem;
	}

	/* hero — the poster */
	.hero {
		padding: 5.5rem 0 5rem;
	}
	.hero > * {
		animation: roll-in 700ms cubic-bezier(0.16, 1, 0.3, 1) both;
	}
	.hero h1 {
		animation-delay: 60ms;
	}
	.billing {
		animation-delay: 200ms;
	}
	.lead {
		animation-delay: 340ms;
	}
	.cta {
		animation-delay: 480ms;
	}
	@keyframes roll-in {
		from {
			opacity: 0;
			transform: translateY(18px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}
	h1 {
		margin: 0 calc(50% - 50vw);
		font-family: 'Archivo Black', 'Archivo', 'Hiragino Kaku Gothic ProN', 'Noto Sans JP', system-ui, sans-serif;
		font-weight: 400;
		/* measured ink width of TETUO41 in Archivo Black ≈ 5.01em; size to fill the viewport minus gutters */
		font-size: max(3.2rem, min(24rem, calc((100vw - 4rem) / 5.02)));
		line-height: 0.85;
		letter-spacing: -0.015em;
		text-transform: uppercase;
		text-align: center;
		white-space: nowrap;
	}

	.billing {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 2rem;
		border-top: 1px solid var(--hairline);
		margin-top: 2rem;
		padding-top: 1rem;
	}
	.billing p {
		margin: 0;
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--muted);
	}
	.billing a {
		color: var(--fg);
		text-decoration: none;
		border-bottom: 1px solid var(--hairline-strong);
	}
	.billing a:hover {
		border-bottom-color: var(--fg);
	}
	.lead {
		margin: 1.6rem 0 0;
		max-width: 36rem;
		color: var(--muted);
		font-size: 0.95rem;
	}
	.cta {
		display: flex;
		gap: 0.75rem;
		margin-top: 2.2rem;
		flex-wrap: wrap;
	}
	.btn {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.72rem 1.3rem;
		border: 1px solid var(--hairline-strong);
		background: transparent;
		color: var(--fg);
		font-weight: 600;
		font-size: 0.78rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		text-decoration: none;
		transition: background 160ms ease, color 160ms ease, border-color 160ms ease, transform 160ms ease;
	}
	.btn:hover {
		background: var(--invert-bg);
		color: var(--invert-fg);
		border-color: var(--invert-bg);
	}
	.btn:active {
		transform: scale(0.98);
	}
	.btn.primary {
		background: var(--invert-bg);
		color: var(--invert-fg);
		border-color: var(--invert-bg);
	}
	.btn.primary:hover {
		background: transparent;
		color: var(--fg);
		border-color: var(--hairline-strong);
	}
	.btn svg {
		width: 16px;
		height: 16px;
	}

	/* links — the index */
	.links {
		padding: 1.5rem 0 5rem;
	}
	h2 {
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.14em;
		color: var(--muted);
		text-transform: uppercase;
		margin: 0 0 0.6rem;
	}
	.links ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.links li {
		border-bottom: 1px solid var(--hairline);
	}
	.links li:first-child {
		border-top: 1px solid var(--hairline);
	}
	.links a {
		display: grid;
		grid-template-columns: auto 1fr auto auto;
		align-items: center;
		gap: 1rem;
		padding: 0.9rem 0.5rem;
		text-decoration: none;
		transition: background 160ms ease, color 160ms ease;
	}
	.links a:hover {
		background: var(--invert-bg);
		color: var(--invert-fg);
	}
	.icon {
		display: inline-flex;
		width: 20px;
		height: 20px;
		color: var(--muted);
		transition: color 160ms ease;
	}
	.links a:hover .icon {
		color: var(--invert-fg);
	}
	.icon svg {
		width: 20px;
		height: 20px;
	}
	.label {
		font-weight: 600;
		font-size: 0.95rem;
	}
	.note {
		color: var(--muted);
		font-size: 0.85rem;
		text-align: right;
		transition: color 160ms ease;
	}
	.links a:hover .note {
		color: rgba(5, 5, 5, 0.65);
	}
	.arrow {
		display: inline-flex;
		width: 15px;
		height: 15px;
		color: var(--muted);
		opacity: 0;
		transform: translate(-4px, 4px);
		transition: opacity 160ms ease, transform 160ms ease, color 160ms ease;
	}
	.arrow svg {
		width: 15px;
		height: 15px;
	}
	.links a:hover .arrow {
		opacity: 1;
		transform: none;
		color: var(--invert-fg);
	}

	.chip-gloss {
		color: var(--muted);
	}
	.chip:hover .chip-gloss {
		color: rgba(5, 5, 5, 0.65);
	}

	/* ticker — the marquee */
	.ticker {
		border-top: 1px solid var(--hairline);
		border-bottom: 1px solid var(--hairline);
		overflow: hidden;
		white-space: nowrap;
	}
	.ticker-track {
		display: inline-flex;
		animation: marquee 80s linear infinite;
	}
	.ticker span {
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
