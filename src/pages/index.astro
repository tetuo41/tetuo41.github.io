const links = [
	{
		label: 'GitHub',
		note: 'コード・プロジェクト',
		url: 'https://github.com/tetuo41',
		icon: 'github',
	},
	{
		label: 'Keybase',
		note: 'このドメインの署名検証',
		url: 'https://keybase.io/tetuo41',
		icon: 'keybase',
	},
	{
		label: 'Twitter(X)',
		note: '@tetuo41',
		url: 'https://twitter.com/tetuo41',
		icon: 'x',
	},
	{
		label: 'Blog「Stay Rad」',
		note: 'blog.tetuo41.com — 執筆先',
		url: 'https://blog.tetuo41.com/',
		icon: 'pen',
	},
	{
		label: 'はてなブログ',
		note: '旧ブログ(更新停止)',
		url: 'http://tetuo41.hatenablog.com/',
		icon: 'archive',
	},
	{
		label: 'SoundCloud',
		note: '音声・ラジオ',
		url: 'https://soundcloud.com/hirokihatsushika',
		icon: 'soundcloud',
	},
	{
		label: 'Medium',
		note: '@tetuo41',
		url: 'https://medium.com/@tetuo41',
		icon: 'medium',
	},
	{
		label: 'Podcast',
		note: 'Yarukinai.fm',
		url: 'https://yarukinai.fm/',
		icon: 'mic',
	},
	{
		label: 'Study Today',
		note: '勉強会イベントサイト(過去の運営)',
		url: 'http://study.tetuo41.com/',
		icon: 'calendar',
	},
