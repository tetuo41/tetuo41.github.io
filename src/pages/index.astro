	soundcloud: `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M1.2 13.4l.3 2.6-.3 2.6c0 .2-.2.2-.3.2s-.2 0-.3-.2l-.3-2.6.3-2.6c0-.1.1-.2.3-.2s.2.1.3.2Zm2-1.5c-.2 0-.3.1-.3.3l-.3 3.8.3 3.7c0 .2.1.3.3.3.1 0 .3-.1.3-.3l.3-3.7-.3-3.8c0-.2-.2-.3-.3-.3Zm2.2-.5c-.2 0-.3.1-.3.3l-.3 4.3.3 4.2c0 .2.1.3.3.3.2 0 .3-.1.3-.3l.4-4.2-.4-4.3c0-.2-.1-.3-.3-.3Zm2.3-.4c-.2 0-.4.2-.4.4l-.3 4.6.3 4.5c0 .2.2.4.4.4s.4-.2.4-.4l.4-4.5-.4-4.6c0-.2-.2-.4-.4-.4Zm2.5-1.6c-.3 0-.5.2-.5.5l-.3 6.1.3 4.4c0 .3.2.5.5.5s.4-.2.4-.5l.4-4.4-.4-6.1c0-.3-.2-.5-.4-.5Zm2.7-1.9c-.3 0-.5.2-.5.5v8.1l.3 4.3c0 .3.2.5.5.5s.5-.2.5-.5l.3-4.3-.3-8.1c0-.3-.2-.5-.5-.5Zm4.7.7c-.5 0-1 .1-1.4.3-.3-3.3-3-5.9-6.4-5.9-.8 0-1.6.2-2.3.4-.3.1-.3.2-.3.5v14.9c0 .3.2.5.5.5h9.9c2 0 3.7-1.7 3.7-3.8.1-2-1.6-3.7-3.7-3.7Z"/></svg>`,
	pen: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5Z"/></svg>`,
