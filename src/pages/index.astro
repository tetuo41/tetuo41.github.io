---

<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="tetuo41 (Hiroki Hatsushika) — Keybase の署名で検証された個人サイト。GitHub・ブログ・Podcast への一次リンク。" />
		<meta name="theme-color" media="(prefers-color-scheme: light)" content="#fafafa" />
		<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#09090b" />
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://tetuo41.com/" />
		<meta property="og:title" content="tetuo41 — Hiroki Hatsushika" />
		<meta property="og:description" content="Keybase の署名で検証された個人サイト。Signature-verified personal index." />
		<meta property="og:image" content="https://tetuo41.com/og.png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<title>tetuo41 — Hiroki Hatsushika</title>
	</head>
	<body>
		<header class="nav">
			<a class="wordmark" href="/"><span class="dot" aria-hidden="true"></span>tetuo41</a>
			<a class="pill" href="https://keybase.io/tetuo41">
				<span class="pulse" aria-hidden="true"></span>
				Keybase で検証済み<span class="pill-gloss">· Signature-verified</span>
			</a>
		</header>

		<main>
			<section class="hero">
				<p class="eyebrow">Hiroki Hatsushika — Tokyo</p>
				<h1>tetuo41</h1>
				<p class="lead">
					このドメインは Keybase の署名で検証された、一次リンクの置き場所です。
					<!-- TODO: 自己紹介文をここに追記 -->
				</p>
				<div class="cta">
					<a class="btn primary" href="https://github.com/tetuo41">
						<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.49 0-.24-.01-.88-.01-1.73-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.5-1.11-1.5-.91-.63.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.9 1.57 2.36 1.12 2.94.85.09-.66.35-1.12.63-1.38-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.7 0 0 .84-.28 2.75 1.05a9.36 9.36 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.4.2 2.44.1 2.7.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.8-4.57 5.06.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .27.18.6.69.49A10.02 10.02 0 0 0 22 12.25C22 6.58 17.52 2 12 2Z"/></svg>
						GitHub
					</a>
					<a class="btn" href="https://keybase.io/tetuo41">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 4.5 6v5c0 4.6 3.2 8.4 7.5 10 4.3-1.6 7.5-5.4 7.5-10V6L12 3Z"/><path d="m9 11.5 2.2 2.2L15.5 9.5"/></svg>
						Keybase 証明を見る
					</a>
				</div>
			</section>

			<section class="links" aria-labelledby="links-h">
				<h2 id="links-h">リンク</h2>
				<ul>
					{links.map((l) => (
						<li>
							<a href={l.url}>
								<span class="icon" set:html={icons[l.icon]} />
								<span class="label">{l.label}</span>
								<span class="note">{l.note}</span>
								<span class="arrow" aria-hidden="true">
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M9 7h8v8"/></svg>
								</span>
							</a>
						</li>
					))}
				</ul>
			</section>
		</main>

		<footer>
			<p class="mono">ed25519 ASDO0lgP…XMwo · <a href="/keybase.txt">keybase.txt</a></p>
			<p>© 2026 tetuo41</p>
		</footer>
	</body>
</html>

<style>
	:root {
		--bg: #fafafa;
		--fg: #18181b;
		--muted: #6b6b74;
		--hairline: #e4e4e7;
		--surface: #ffffff;
		--hover: #f4f4f5;
		--accent: #5b5bd6;
		--accent-soft: rgba(91, 91, 214, 0.08);
		--btn-primary-bg: #18181b;
		--btn-primary-fg: #fafafa;
		--selection: rgba(91, 91, 214, 0.22);
		--glow: rgba(91, 91, 214, 0.055);
		color-scheme: light;
	}
	@media (prefers-color-scheme: dark) {
		:root {
			--bg: #09090b;
			--fg: #f4f4f5;
			--muted: #94949e;
			--hairline: #232327;
			--surface: #101013;
			--hover: #17171b;
			--accent: #8b8bf2;
			--accent-soft: rgba(139, 139, 242, 0.1);
			--btn-primary-bg: #f4f4f5;
			--btn-primary-fg: #09090b;
			--selection: rgba(139, 139, 242, 0.28);
			--glow: rgba(139, 139, 242, 0.07);
			color-scheme: dark;
		}
	}

	* {
		box-sizing: border-box;
	}
	html {
		scroll-behavior: smooth;
	}
	body {
		margin: 0;
		background:
			radial-gradient(60rem 30rem ellipse at 50% -12rem, var(--glow), transparent 65%)
				no-repeat,
			var(--bg);
		color: var(--fg);
		font-family: 'Geist Sans', 'Hiragino Kaku Gothic ProN', 'Noto Sans JP', system-ui, sans-serif;
		font-size: 16px;
		line-height: 1.7;
		-webkit-font-smoothing: antialiased;
	}
	::selection {
		background: var(--selection);
	}
	:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
		border-radius: 4px;
	}
	a {
		color: inherit;
	}

	/* nav */
	.nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 44rem;
		margin: 0 auto;
		padding: 1.4rem 1.5rem 0;
	}
	.wordmark {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		font-weight: 700;
		font-size: 0.95rem;
		letter-spacing: -0.01em;
		text-decoration: none;
	}
	.dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--accent);
	}
	.pill {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.8rem;
		font-weight: 500;
		color: var(--muted);
		text-decoration: none;
		border: 1px solid var(--hairline);
		border-radius: 999px;
		padding: 0.35rem 0.85rem;
		background: var(--surface);
		transition: border-color 150ms ease, color 150ms ease;
	}
	.pill:hover {
		border-color: var(--accent);
		color: var(--fg);
	}
	.pulse {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--accent);
		animation: pulse 2.4s ease-out infinite;
	}
	@keyframes pulse {
		0% {
			box-shadow: 0 0 0 0 var(--accent-soft);
		}
		70% {
			box-shadow: 0 0 0 7px transparent;
		}
		100% {
			box-shadow: 0 0 0 0 transparent;
		}
	}

	main {
		max-width: 44rem;
		margin: 0 auto;
		padding: 0 1.5rem;
	}

	/* hero */
	.hero {
		padding: 6.5rem 0 5.5rem;
		animation: rise 600ms cubic-bezier(0.16, 1, 0.3, 1) both;
	}
	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(12px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.hero {
			animation: none;
		}
		.pulse {
			animation: none;
		}
		html {
			scroll-behavior: auto;
		}
	}
	.eyebrow {
		margin: 0 0 0.9rem;
		font-family: 'Geist Mono', ui-monospace, monospace;
		font-size: 0.85rem;
		font-weight: 500;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--muted);
	}
	h1 {
		margin: 0;
		font-size: clamp(4.5rem, 13vw, 7.5rem);
		font-weight: 800;
		letter-spacing: -0.04em;
		line-height: 1.02;
	}
	.lead {
		margin: 1.4rem 0 0;
		max-width: 36rem;
		color: var(--muted);
		font-size: 1.05rem;
	}
	.cta {
		display: flex;
		gap: 0.75rem;
		margin-top: 2.2rem;
		flex-wrap: wrap;
	}
	.btn {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.62rem 1.15rem;
		border-radius: 12px;
		border: 1px solid var(--hairline);
		background: var(--surface);
		color: var(--fg);
		font-weight: 600;
		font-size: 0.9rem;
		text-decoration: none;
		transition: border-color 150ms ease, background 150ms ease, transform 150ms ease;
	}
	.btn:hover {
		border-color: var(--muted);
	}
	.btn:active {
		transform: scale(0.98);
	}
	.btn.primary {
		background: var(--btn-primary-bg);
		color: var(--btn-primary-fg);
		border-color: transparent;
	}
	.btn.primary:hover {
		opacity: 0.88;
	}
	.btn svg {
		width: 18px;
		height: 18px;
	}

	/* links */
	.links {
		padding: 1.5rem 0 4rem;
	}
	h2 {
		font-size: 0.85rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		color: var(--muted);
		text-transform: uppercase;
		margin: 0 0 0.4rem;
	}
	.links ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.links li {
		border-bottom: 1px solid var(--hairline);
	}
	.links li:first-child {
		border-top: 1px solid var(--hairline);
	}
	.links a {
		display: grid;
		grid-template-columns: auto 1fr auto auto;
		align-items: center;
		gap: 1rem;
		padding: 0.85rem 0.4rem;
		text-decoration: none;
		transition: background 150ms ease;
	}
	.links a:hover {
		background: var(--hover);
	}
	.icon {
		display: inline-flex;
		width: 20px;
		height: 20px;
		color: var(--muted);
	}
	.icon svg {
		width: 20px;
		height: 20px;
	}
	.label {
		font-weight: 600;
		font-size: 0.95rem;
	}
	.note {
		color: var(--muted);
		font-size: 0.85rem;
		text-align: right;
	}
	.arrow {
		display: inline-flex;
		width: 15px;
		height: 15px;
		color: var(--muted);
		opacity: 0;
		transform: translate(-4px, 4px);
		transition: opacity 150ms ease, transform 150ms ease;
	}
	.arrow svg {
		width: 15px;
		height: 15px;
	}
	.links a:hover .arrow {
		opacity: 1;
		transform: none;
	}
	.links a:hover .icon {
		color: var(--accent);
	}

	.pill-gloss {
		color: var(--muted);
	}

	/* footer */
	footer {
		max-width: 44rem;
		margin: 0 auto;
		padding: 2rem 1.5rem 3.5rem;
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
		flex-wrap: wrap;
		border-top: 1px solid var(--hairline);
	}
	footer p {
		margin: 0;
		color: var(--muted);
		font-size: 0.8rem;
	}
	.mono {
		font-family: 'Geist Mono', ui-monospace, monospace;
		letter-spacing: 0.01em;
	}
	.mono a {
		color: var(--muted);
		text-underline-offset: 3px;
	}
	.mono a:hover {
		color: var(--accent);
	}

	@media (max-width: 560px) {
		.pill {
			font-size: 0.72rem;
			padding: 0.3rem 0.65rem;
		}
		.pill-gloss {
			display: none;
		}
		.hero {
			padding: 4.5rem 0 4rem;
		}
		.note {
			display: none;
		}
		.links a {
			grid-template-columns: auto 1fr auto;
		}
		footer {
			flex-direction: column;
			gap: 0.4rem;
		}
	}
</style>
